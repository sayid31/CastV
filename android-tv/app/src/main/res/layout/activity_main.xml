<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#081923">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CastV Receiver"
            android:textColor="#F0FFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari lagi"
            android:textColor="#081923"
            android:backgroundTint="#72E3DC" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mencari CastV di Wi-Fi…"
        android:textColor="#9CC8CD"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/receiverWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#020A0E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/manualHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="PC IP (opsional)"
            android:inputType="text"
            android:textColor="#E6FFFF"
            android:textColorHint="#6E9298"
            android:backgroundTint="#2C5962" />

        <Button
            android:id="@+id/manualConnectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Hubungkan manual"
            android:textColor="#E6FFFF"
            android:backgroundTint="#1C4653" />
    </LinearLayout>
</LinearLayout>
